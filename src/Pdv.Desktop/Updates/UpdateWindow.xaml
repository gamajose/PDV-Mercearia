<Window x:Class="Pdv.Desktop.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atualização do PDV Gama"
        Width="460"
        Height="330"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6FA">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Width="58"
                Height="58"
                CornerRadius="18"
                Background="#EAF1FF"
                HorizontalAlignment="Left">
            <TextBlock FontFamily="Segoe Fluent Icons"
                       Text="&#xE895;"
                       FontSize="28"
                       Foreground="#2563EB"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Nova versão disponível"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="VersionText"
                       Margin="0,5,0,0"
                       Foreground="#718096" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
            <ProgressBar x:Name="DownloadProgress"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         BorderThickness="0"
                         Foreground="#2563EB"
                         Background="#DFE6F0" />
            <Grid Margin="0,9,0,0">
                <TextBlock x:Name="StatusText"
                           Text="Preparando o download..."
                           Foreground="#5E6B80"
                           FontSize="12" />
                <TextBlock x:Name="ProgressText"
                           Text="0%"
                           HorizontalAlignment="Right"
                           Foreground="#5E6B80"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,20,0,0"
                   TextWrapping="Wrap"
                   Foreground="#718096"
                   FontSize="11"
                   Text="O instalador correto será aplicado automaticamente. O banco e as configurações da loja serão preservados." />

        <Grid Grid.Row="4" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="LaterButton"
                    Content="Depois"
                    Width="92"
                    Height="42"
                    BorderThickness="0"
                    Background="#E9EDF3"
                    Foreground="#435066"
                    Click="Later_Click" />

            <Button x:Name="InstallButton"
                    Grid.Column="1"
                    Content="Reiniciar e atualizar"
                    Width="175"
                    Height="42"
                    BorderThickness="0"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    IsEnabled="False"
                    Click="Install_Click" />
        </Grid>
    </Grid>
</Window>
