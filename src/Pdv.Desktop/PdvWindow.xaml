<Window x:Class="Pdv.Desktop.PdvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDV Gama - Frente de Caixa"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="White"
        KeyDown="Window_KeyDown"
        FocusManager.FocusedElement="{Binding ElementName=BarcodeInput}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Topo: Identificação e Status -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PDV GAMA" FontWeight="Bold" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="StoreInfoText" Text="LOJA: Matriz | CAIXA 01 | OPERADOR: Administrador" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="ScaleStatusText" Text="BALANÇA: Conectada (0.000 kg)" FontSize="13" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="ClockText" Text="12:00:00" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Meio: Lista do Cupom (Esquerda) e Painel do Item/Total (Direita) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Cupom de Itens -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ITENS DA VENDA" FontSize="15" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,8" />
                    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B"
                              AlternatingRowBackground="#243248" Foreground="White"
                              GridLinesVisibility="None" HeadersVisibility="Column" FontSize="14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding ItemIndex}" Width="40" />
                            <DataGridTextColumn Header="Código" Binding="{Binding Sku}" Width="110" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity, StringFormat='{}{0:N3}'}" Width="80" />
                            <DataGridTextColumn Header="Preço Un." Binding="{Binding UnitPrice, StringFormat='{}{0:C2}'}" Width="100" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:C2}'}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Painel do Item Atual e Totais -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Item Selecionado / Último Bipado -->
                <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMO ITEM" FontSize="12" Foreground="#94A3B8" />
                        <TextBlock x:Name="LastItemNameText" Text="CAIXA LIVRE" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="QUANTIDADE" FontSize="11" Foreground="#94A3B8" />
                                <TextBlock x:Name="LastItemQtyText" Text="1,000 UN" FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VALOR UNITÁRIO" FontSize="11" Foreground="#94A3B8" />
                                <TextBlock x:Name="LastItemPriceText" Text="R$ 0,00" FontSize="16" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Totais da Venda -->
                <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="16">
                    <StackPanel VerticalAlignment="Bottom">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="SUBTOTAL" FontSize="15" Foreground="#94A3B8" />
                            <TextBlock x:Name="SubtotalText" Text="R$ 0,00" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="DESCONTO" FontSize="15" Foreground="#94A3B8" />
                            <TextBlock x:Name="DiscountText" Text="R$ 0,00" FontSize="18" FontWeight="SemiBold" Foreground="#F87171" HorizontalAlignment="Right" />
                        </Grid>
                        <Separator Background="#334155" Margin="0,0,0,12" />
                        <TextBlock Text="TOTAL A PAGAR" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock x:Name="TotalText" Text="R$ 0,00" FontSize="38" FontWeight="Bold" Foreground="#4ADE80" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Campo de Entrada: Código de Barras / PLU -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CÓDIGO / BARRAS:" FontWeight="Bold" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBox x:Name="BarcodeInput" Grid.Column="1" FontSize="20" FontWeight="Bold" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,4" KeyDown="BarcodeInput_KeyDown" />
                <Button Grid.Column="2" Content="ADICIONAR" FontWeight="Bold" Background="#2563EB" Foreground="White" Padding="20,0" Margin="10,0,0,0" BorderThickness="0" Click="AddItem_Click" />
            </Grid>
        </Border>

        <!-- Barra Inferior de Teclas de Atalho -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="8" Padding="10,8">
            <UniformGrid Rows="1" Columns="7">
                <Button Content="[F2] Buscar Prod" Style="{StaticResource ShortcutBtn}" Click="F2_Click" />
                <Button Content="[F3] Balança" Style="{StaticResource ShortcutBtn}" Click="F3_Click" />
                <Button Content="[F4] Desconto" Style="{StaticResource ShortcutBtn}" Click="F4_Click" />
                <Button Content="[F5] Cancelar Item" Style="{StaticResource ShortcutBtn}" Click="F5_Click" />
                <Button Content="[F6] Cancelar Venda" Style="{StaticResource ShortcutBtn}" Click="F6_Click" />
                <Button Content="[F10] Pagamento" Background="#16A34A" Style="{StaticResource ShortcutBtn}" Click="F10_Click" />
                <Button Content="[ESC] Sair" Background="#DC2626" Style="{StaticResource ShortcutBtn}" Click="Esc_Click" />
            </UniformGrid>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="ShortcutBtn" TargetType="Button">
            <Setter Property="Background" Value="#334155" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
</Window>
