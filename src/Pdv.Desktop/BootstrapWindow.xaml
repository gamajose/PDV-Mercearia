<Window x:Class="Pdv.Desktop.BootstrapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração inicial"
        Width="620"
        Height="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontFamily="Segoe Fluent Icons"
                           Text="&#xE713;"
                           FontSize="34"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="Configurar esta loja"
                           FontSize="27"
                           FontWeight="SemiBold"
                           Margin="0,12,0,4" />
                <TextBlock Text="O banco e o serviço local já estão prontos. Identifique a empresa e a filial."
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Razão social" FontWeight="SemiBold" />
                    <TextBox x:Name="LegalNameTextBox" />
                    <TextBlock Text="Nome da empresa" FontWeight="SemiBold" />
                    <TextBox x:Name="TradeNameTextBox" />
                    <TextBlock Text="Código da loja" FontWeight="SemiBold" />
                    <TextBox x:Name="StoreCodeTextBox" Text="LOJA01" />
                    <TextBlock Text="Nome da loja" FontWeight="SemiBold" />
                    <TextBox x:Name="StoreNameTextBox" Text="Loja 01" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Ramo" FontWeight="SemiBold" />
                    <ComboBox x:Name="SegmentComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="Mercearia" Tag="0" />
                        <ComboBoxItem Content="Supermercado" Tag="1" />
                        <ComboBoxItem Content="Hortifruti" Tag="2" />
                        <ComboBoxItem Content="Açougue" Tag="3" />
                        <ComboBoxItem Content="Padaria" Tag="4" />
                        <ComboBoxItem Content="Conveniência" Tag="5" />
                        <ComboBoxItem Content="Comércio geral" Tag="6" />
                    </ComboBox>

                    <CheckBox x:Name="HubCheckBox"
                              Content="Esta é a loja administradora"
                              Margin="0,10,0,18"
                              FontWeight="SemiBold"
                              Checked="HubCheckBox_Changed"
                              Unchecked="HubCheckBox_Changed" />

                    <TextBlock Text="Endereço da loja administradora"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="HubUrlTextBox"
                             Text="https://"
                             IsEnabled="True" />

                    <TextBlock Text="Chave de sincronização"
                               FontWeight="SemiBold" />
                    <PasswordBox x:Name="HubKeyPasswordBox"
                                 Padding="12,9"
                                 Margin="0,5,0,12"
                                 BorderBrush="#D8DEEA" />

                    <TextBlock Text="Filiais usam esses dois campos para enviar dados consolidados. A loja administradora deixa ambos vazios."
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Padding="18,10"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button Content="Concluir"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="Finish_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
