<Window x:Class="Pdv.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDV Gama"
        Width="1280"
        Height="780"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#14213A">
            <Grid Margin="0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="44"
                        Height="44"
                        CornerRadius="14"
                        Background="#2563EB"
                        HorizontalAlignment="Center">
                    <TextBlock Text="G"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Top"
                            Margin="0,30,0,0">
                    <Button Content="&#xE80F;"
                            ToolTip="Visão geral"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Dashboard_Click" />
                    <Button Content="&#xE719;"
                            ToolTip="Nova venda"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Sales_Click" />
                    <Button Content="&#xE7C3;"
                            ToolTip="Produtos"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Products_Click" />
                    <Button Content="&#xE7B8;"
                            ToolTip="Estoque"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Inventory_Click" />
                    <Button Content="&#xE8CB;"
                            ToolTip="Compras"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Purchases_Click" />
                    <Button Content="&#xE9D2;"
                            ToolTip="Relatórios"
                            Style="{StaticResource IconButtonStyle}"
                            Click="Reports_Click" />
                </StackPanel>

                <Button Grid.Row="2"
                        Content="&#xE713;"
                        ToolTip="Configurações"
                        Style="{StaticResource IconButtonStyle}"
                        Click="Settings_Click" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,22,30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="SectionTitleText"
                               Text="Visão geral"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StoreText"
                               Text="Conectando..."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="14"
                        Padding="14,9"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusEllipse"
                                 Width="9"
                                 Height="9"
                                 Fill="#F59E0B"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusText"
                                   Text="Verificando"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="DashboardPanel" Grid.Row="1" Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Columns="4">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8C7;"
                                       FontSize="23"
                                       Foreground="#2563EB" />
                            <TextBlock Text="Vendas hoje"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,4" />
                            <TextBlock x:Name="SalesTodayText"
                                       Text="R$ 0,00"
                                       FontSize="25"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE8A5;"
                                       FontSize="23"
                                       Foreground="#16A34A" />
                            <TextBlock Text="Operações"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,4" />
                            <TextBlock x:Name="TransactionsText"
                                       Text="0"
                                       FontSize="25"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE814;"
                                       FontSize="23"
                                       Foreground="#EA580C" />
                            <TextBlock Text="Estoque baixo"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,4" />
                            <TextBlock x:Name="LowStockText"
                                       Text="0"
                                       FontSize="25"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE895;"
                                       FontSize="23"
                                       Foreground="#7C3AED" />
                            <TextBlock Text="A sincronizar"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,14,0,4" />
                            <TextBlock x:Name="PendingSyncText"
                                       Text="0"
                                       FontSize="25"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Movimento do dia"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="  •  por horário"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Canvas x:Name="ChartCanvas"
                                    Grid.Row="1"
                                    Height="280"
                                    Margin="0,24,0,0"
                                    SizeChanged="ChartCanvas_SizeChanged" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Ações rápidas"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,18" />

                            <Button Height="58"
                                    Background="#EEF4FF"
                                    BorderThickness="0"
                                    Margin="0,0,0,10"
                                    Click="Sales_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE719;"
                                               FontSize="20"
                                               Foreground="#2563EB"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="Iniciar venda"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Height="58"
                                    Background="#F0FDF4"
                                    BorderThickness="0"
                                    Margin="0,0,0,10"
                                    Click="Products_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE7C3;"
                                               FontSize="20"
                                               Foreground="#16A34A"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="Cadastrar produto"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Height="58"
                                    Background="#FFF7ED"
                                    BorderThickness="0"
                                    Click="Inventory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               Text="&#xE7B8;"
                                               FontSize="20"
                                               Foreground="#EA580C"
                                               Margin="0,0,12,0" />
                                    <TextBlock Text="Consultar estoque"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="PlaceholderPanel"
                    Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Margin="8,24,8,8"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="PlaceholderIcon"
                               FontFamily="Segoe Fluent Icons"
                               Text="&#xE946;"
                               FontSize="54"
                               Foreground="#AAB5C6"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="PlaceholderTitle"
                               Text="Módulo"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,6" />
                    <TextBlock Text="A base está pronta para receber esta funcionalidade na próxima entrega."
                               Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
