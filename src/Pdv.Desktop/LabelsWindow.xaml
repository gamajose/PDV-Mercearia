<Window x:Class="Pdv.Desktop.LabelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDV Gama - Terminal de Etiquetas e Consulta de Preços"
        Width="1050"
        Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Topo -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TERMINAL DE ETIQUETAS E CONSULTA" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                    <TextBlock Text="Geração de etiquetas térmicas de gôndola, vestuário e produtos para loja e balcão." FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Atualizar Produtos" Background="#334155" Foreground="White" BorderThickness="0" Padding="14,8" FontWeight="SemiBold" Click="Refresh_Click" />
            </Grid>
        </Border>

        <!-- Conteúdo: Seleção de Produtos e Configuração de Etiqueta -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Tabela de Produtos -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Background="#0F172A" Foreground="White" BorderBrush="#334155" FontSize="14" Padding="8,6" TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="Buscar por Nome, SKU ou Código de Barras..." Foreground="#64748B" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B"
                              AlternatingRowBackground="#243248" Foreground="White"
                              HeadersVisibility="Column" SelectionMode="Extended" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="80" />
                            <DataGridTextColumn Header="Código de Barras" Binding="{Binding Barcode}" Width="120" />
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Preço" Binding="{Binding SalePrice, StringFormat='{}{0:C2}'}" Width="90" />
                            <DataGridTextColumn Header="Estoque" Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Configuração de Impressão -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="PARÂMETROS DE IMPRESSÃO" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,16" />

                    <TextBlock Text="Modelo da Etiqueta:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ComboBox x:Name="LayoutCombo" SelectedIndex="0" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12">
                        <ComboBoxItem Content="Gôndola Supermercado (100x30mm)" />
                        <ComboBoxItem Content="Vestuário / Grade Tamanho e Cor" />
                        <ComboBoxItem Content="Produto com Código de Barras Padrão" />
                    </ComboBox>

                    <TextBlock Text="Linguagem da Impressora:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ComboBox x:Name="LanguageCombo" SelectedIndex="0" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12">
                        <ComboBoxItem Content="Zebra ZPL II (Zebra ZD220, GC420t, etc.)" />
                        <ComboBoxItem Content="Elgin / Argox EPL2 (L42 Pro, OS-214)" />
                    </ComboBox>

                    <TextBlock Text="Nome da Impressora no Windows / IP:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox x:Name="PrinterTargetInput" Text="ZDesigner ZD220-203dpi ZPL" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,12" />

                    <TextBlock Text="Cópias por Produto:" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <TextBox x:Name="CopiesInput" Text="1" Background="#0F172A" Foreground="White" BorderBrush="#334155" Padding="8,6" Margin="0,0,0,20" />

                    <Button Content="IMPRIMIR ETIQUETAS" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" Height="48" BorderThickness="0" Click="Print_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,16,0,0">
            <TextBlock x:Name="StatusLabel" Text="Selecione os produtos na tabela para gerar as etiquetas." FontSize="13" Foreground="#94A3B8" />
        </Border>
    </Grid>
</Window>
